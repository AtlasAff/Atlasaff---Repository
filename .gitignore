# Dependências instaladas localmente — cada um que rodar a ferramenta
# instala a sua com "npm install", não faz sentido versionar.
node_modules/

# Sessão logada do AliExpress (cookies reais da sua conta) — fica só na
# sua máquina, nunca deve ir pro repositório.
ferramentas/importar-aliexpress/.sessao-aliexpress.json

# Login de admin + chave da IA salvos localmente (texto puro) pra não
# perguntar toda hora — nunca deve ir pro repositório.
ferramentas/importar-aliexpress/.credenciais.json

# Arquivos de "raio-x" de página gerados quando algum campo não é
# encontrado na importação — só servem pra depurar localmente.
ferramentas/importar-aliexpress/debug/

# Arquivos de sistema comuns
.DS_Store
