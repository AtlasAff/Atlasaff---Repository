<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- O título vai se atualizar sozinho com o JS abaixo -->
    <title>Promoción Oficial</title>
    <style>
        :root {
            --primary-color: #22c55e; /* Verde promocional */
            --button-color: #ff4747;  /* Vermelho escuro para urgência */
            --bg-color: #f8fafc;
        }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--bg-color);
            color: #1e293b;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .card {
            background: white;
            padding: 35px 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            max-width: 440px;
            width: 100%;
            text-align: center;
            border-top: 6px solid var(--primary-color);
        }
        .badge {
            background-color: #fef08a;
            color: #854d0e;
            padding: 6px 16px;
            border-radius: 99px;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 15px;
        }
        h1 {
            font-size: 26px;
            margin: 0 0 10px 0;
            color: #0f172a;
        }
        .timer-box {
            background: #f1f5f9;
            padding: 10px;
            border-radius: 8px;
            margin: 20px 0;
            font-weight: bold;
            color: #ef4444;
            font-size: 15px;
        }
        #timer {
            font-size: 18px;
            display: inline-block;
            letter-spacing: 1px;
        }
        .price-box {
            margin: 25px 0;
        }
        .old-price {
            text-decoration: line-through;
            color: #94a3b8;
            font-size: 16px;
        }
        .new-price {
            color: var(--primary-color);
            font-size: 36px;
            font-weight: 800;
            margin: 5px 0;
        }
        .btn {
            display: block;
            background-color: var(--button-color);
            color: white;
            text-decoration: none;
            padding: 16px 20px;
            font-weight: bold;
            font-size: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(255, 71, 71, 0.3);
            animation: pulse 2s infinite;
            transition: transform 0.2s;
        }
        .btn:hover {
            transform: scale(1.02);
        }
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(255, 71, 71, 0.5); }
            70% { box-shadow: 0 0 0 12px rgba(255, 71, 71, 0); }
            100% { box-shadow: 0 0 0 0 rgba(255, 71, 71, 0); }
        }
        .secure-footer {
            margin-top: 30px;
            font-size: 12px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 15px;
        }
    </style>
</head>
<body>

<div class="card">
    <div class="badge">🔥 ¡Oferta Exclusiva por Tiempo Limitado!</div>
    <h1 id="prod-title">Cargando...</h1>
    
    <div class="timer-box">
        ⏳ La oferta expira en: <span id="timer">15:00</span>
    </div>

    <div class="price-box">
        <div class="old-price">Precio regular: <span id="old-val">--</span></div>
        <div class="new-price" id="new-val">--</div>
        <div style="font-size: 13px; color: #22c55e; font-weight: bold;" id="discount-text">Ahorras --</div>
    </div>
    
    <a href="#" id="checkout-btn" class="btn">Acceder Al Descuento Ahora</a>

    <div class="secure-footer">
        🔒 Conexión segura y encriptada. Distribución oficial autorizada.
    </div>
</div>

<script>
    // ==========================================
    // ⚙️ SECCIÓN DE CONFIGURACIÓN (CAMBIE AQUÍ)
    // ==========================================
    const CONFIG = {
        nombreProducto: "MelaminaPRO",     // Nome do produto na tela
        precioOriginal: "R$ 197",          // Preço antigo (riscado)
        precioDescuento: "R$ 97",          // Preço com desconto final
        porcentajeDescuento: "50%",        // Porcentagem para o texto de aviso
        linkAfiliado: "https://go.hotmart.com/V106526209Y" // Seu link da Hotmart
    };

    // ==========================================
    // 🧠 SCRIPT AUTOMÁTICO (NÃO MEXER EMBAIXO)
    // ==========================================
    document.title = `Promoción Oficial | ${CONFIG.nombreProducto}`;
    document.getElementById("prod-title").innerText = CONFIG.nombreProducto;
    document.getElementById("old-val").innerText = CONFIG.precioOriginal;
    document.getElementById("new-val").innerText = CONFIG.precioDescuento;
    document.getElementById("discount-text").innerText = `¡Ahorras un ${CONFIG.porcentajeDescuento} HOY!`;
    document.getElementById("checkout-btn").href = CONFIG.linkAfiliado;

    // Timer de 15 Minutos Correndo
    function startTimer(duration, display) {
        let timer = duration, minutes, seconds;
        setInterval(function () {
            minutes = parseInt(timer / 60, 10);
            seconds = parseInt(timer % 60, 10);

            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;

            display.textContent = minutes + ":" + seconds;

            if (--timer < 0) {
                timer = duration; // Reseta se chegar a zero
            }
        }, 1000);
    }

    window.onload = function () {
        let fifteenMinutes = 60 * 15,
            display = document.querySelector('#timer');
        startTimer(fifteenMinutes, display);
    };
</script>

</body>
</html>
